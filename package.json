{
  "name": "attest",
  "version": "0.1.0",
  "description": "Offline C2PA content-credentials verifier and provenance viewer. Verifies real signatures on signed media in the browser or CI, with no upload.",
  "type": "module",
  "author": "svx",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/cli.ts"
  ],
  "private": true,
  "bin": {
    "attest": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "c2pa",
    "content-credentials",
    "provenance",
    "cryptography",
    "cose",
    "jumbf",
    "x509",
    "media-verification",
    "ai-transparency",
    "mcp",
    "agents",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "repository": "https://github.com/srivtx/attest",
  "homepage": "https://srivtx.github.io/attest",
  "bugs": {
    "url": "https://github.com/srivtx/attest/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "spec",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
